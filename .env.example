# Application
APP_NAME=cash-controller
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["*"]

# Telegram Bot (get token from @BotFather)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Allowed Telegram user IDs (comma-separated, get from @userinfobot)
ADMIN_CHAT_IDS=[123456789,987654321]
